.agents/
agent-scratch/
integration/.scratch/
node_modules/
.DS_Store
.sst/
.turbo/
dist/
build/
# docs/build/ is the COMMITTED build-memory v2 root (build-memory migrate, MAINT.1) — re-include it
# above the generic build/ ignore; only its regenerable logs stay ignored.
!docs/build/
docs/build/logs/
*.tsbuildinfo
.env
.env.*
!.env.example
provenance-artifacts/
# The Pulumi program is operator-run; its npm lockfile + compiled output are generated at deploy time.
# (Versions are pinned in infra/pulumi/package.json, which IS committed.)
infra/pulumi/package-lock.json
infra/pulumi/bin/
# The proprietary Agent SDK is vendored into the run-task image at build (REQ-ARCH-4); the tree stays
# untracked (only vendor/README.md is committed, to keep the guarded `COPY vendor/` source present).
apps/run-task/vendor/claude-agent-sdk/
# the platform native `claude` binary (~216 MB) the wrapper spawns (F1) — vendored the same way, untracked.
apps/run-task/vendor/claude-agent-sdk-linux-x64/
apps/run-task/vendor/claude-agent-sdk-*/
# Private checkout (REQ-ARCH-37): `evals/` holds eval IP and stays untracked — the tracked `evals-stub`
# is its public fallback, resolved by path via RHEMA_EVALS_PATH. NOTE: `packages/protocols` is now a
# COMMITTED workspace member (operator decision, 2026-09-01; spec amendment to REQ-ARCH-37/§13.2) — the
# repo is private, so the protocol IP lives in its history; open-source-readiness is an export-time swap
# to `packages/protocols-stub` (renamed `@rhema/protocols-stub`) rather than a live path resolution.
evals/

# The editor client bundle (PRB.07) is generated by apps/web/build-client.mjs at `pnpm build` — a build
# artifact, rebuilt on every checkout, never committed.
apps/web/public/

# JOURNEY.1 — the Playwright storageState session cache (per-identity, gitignored — sessions are
# secrets-adjacent: never commit). `journey-report/` is the CI artifact dir (committed evidence lives
# under docs/build/reports/<date>_JOURNEY.1-journeys/ instead).
.journeys-state/
journey-report/
