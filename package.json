{
  "name": "rhema",
  "version": "0.0.0",
  "private": true,
  "description": "Rhema monorepo — pnpm + Turborepo, TypeScript end-to-end (Q-3).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19",
    "//": ">=20.19 — Vite 8 (Rolldown) requires ^20.19.0 || >=22.12.0 (SPA.1, REQ-TL-10); the SPA build is part of @rhema/web's `build`, so the floor binds the whole repo."
  },
  "scripts": {
    "preinstall": "node scripts/resolve-protocols.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:protocol-markers": "node scripts/check-protocol-markers.mjs",
    "check:no-cookies": "node scripts/check-no-cookies.mjs",
    "check:spa-budget": "node scripts/check-spa-budget.mjs",
    "check:spa-entry-graph": "node scripts/check-spa-entry-graph.mjs",
    "check:spa-env": "node scripts/check-spa-env.mjs",
    "check:dom-contract": "node scripts/check-dom-contract.mjs",
    "check:demo-corpus": "node tools/demo-corpus/check-corpus.mjs",
    "nightly:golden": "node scripts/nightly-golden.mjs",
    "format": "prettier --check ."
  },
  "pnpm": {
    "//": "esbuild ships a platform binary via its build script; Vitest/tsx need it. All other dependency build scripts stay blocked by default (pnpm 10).",
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-rhema": "workspace:*",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.10.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
