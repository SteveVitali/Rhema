{
  "name": "@rhema/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Run orchestration core (§12.4): state machine, run creation, locks, provisioning, internal run API, reaper, phase loop, project-state function. Pure and dependency-injected (P0.08).",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@rhema/contracts": "workspace:*",
    "@rhema/db": "workspace:*",
    "@rhema/engine": "workspace:*",
    "@rhema/hooks": "workspace:*",
    "@rhema/mirror": "workspace:*",
    "@rhema/protocols": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
