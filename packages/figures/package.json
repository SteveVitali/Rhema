{
  "name": "@rhema/figures",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure-TS deterministic figure rendering: Vega-Lite + beautiful-mermaid → light/dark SVG, PNG@2x via resvg (§7.5, P1.13).",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@rhema/tokens": "workspace:*",
    "beautiful-mermaid": "^1.1.3",
    "d3-dsv": "^3.0.1",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@types/d3-dsv": "^3.0.7"
  }
}
