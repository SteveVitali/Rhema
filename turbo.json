{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "remoteCache": {
    "enabled": true
  },
  "globalDependencies": ["tsconfig.base.json", ".npmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // public/** — apps/web's generated client bundles: the esbuild islands + fonts and the Vite
      // SPA output at apps/web/public/spa/** (SPA.1, REQ-TL-3). Without this Turbo neither caches
      // the Vite output nor restores it on a remote-cache hit.
      "outputs": ["dist/**", "*.tsbuildinfo", "public/**"]
    },
    "typecheck": {
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": [],
      "outputs": ["coverage/**"]
    }
  }
}
