{
  "name": "@rhema/fetcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "fetcher — network-only link reads; SSRF-guarded, parses nothing (§13.3).",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
