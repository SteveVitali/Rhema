# Dockerfile.privsep-test — a minimal image that proves the AC1/AC4 KERNEL mechanics of the run-task contract
# without the vendored SDK. Built + run in the `integration` CI job (Linux) with CAP_SYS_ADMIN; on a dev box
# with Docker: `docker build -f apps/run-task/Dockerfile.privsep-test -t rhema-privsep .` then
# `docker run --rm --cap-add SYS_ADMIN rhema-privsep`. Exits non-zero if any assertion fails.
FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends util-linux \
  && rm -rf /var/lib/apt/lists/*
# the same two uids as the runtime image, plus a distinct scoped uid (10003) for the second-reader.
RUN groupadd --gid 10001 harness && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin harness \
  && groupadd --gid 10002 agent   && useradd --uid 10002 --gid 10002 --no-create-home --shell /usr/sbin/nologin agent \
  && groupadd --gid 10003 scoped  && useradd --uid 10003 --gid 10003 --no-create-home --shell /usr/sbin/nologin scoped
COPY apps/run-task/docker/privsep-check.sh /privsep-check.sh
RUN chmod 0755 /privsep-check.sh
# runs as root so it can create the 0600 harness file and mount/unshare/chroot (needs CAP_SYS_ADMIN at run).
ENTRYPOINT ["/privsep-check.sh"]
