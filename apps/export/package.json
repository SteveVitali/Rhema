{
  "name": "@rhema/export",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "export — pandoc container: md/txt/docx from canonical markdown (§12.1, §13.4).",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
