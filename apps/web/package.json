{
  "name": "@rhema/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "web — React Router SSR beta shell (flat, invite-gated).",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node build-client.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.client.json",
    "lint": "eslint .",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@rhema/api-client": "workspace:*",
    "@rhema/commands": "workspace:*",
    "@rhema/contracts": "workspace:*",
    "@rhema/editor": "workspace:*",
    "@rhema/ide": "workspace:*",
    "@rhema/findings-core": "workspace:*",
    "@rhema/run-sheet": "workspace:*",
    "@rhema/tokens": "workspace:*",
    "@rhema/ui": "workspace:*",
    "@hocuspocus/provider": "^4.7.0",
    "hono": "^4.6.14",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.37.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.9.1",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.21"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5"
  }
}
