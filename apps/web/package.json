{
  "name": "@rhema/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "web — React Router SSR beta shell (flat, invite-gated).",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node build-client.mjs && vite build",
    "build:spa": "vite build",
    "dev:spa": "vite build --watch",
    "typecheck": "tsc -b && tsc -p tsconfig.client.json && tsc -p tsconfig.spa.json",
    "lint": "eslint .",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@hocuspocus/provider": "^4.7.0",
    "@hono/node-server": "^2.1.1",
    "@rhema/api-client": "workspace:*",
    "@rhema/commands": "workspace:*",
    "@rhema/contracts": "workspace:*",
    "@rhema/demo-corpus": "workspace:*",
    "@rhema/editor": "workspace:*",
    "@rhema/findings-core": "workspace:*",
    "@rhema/ide": "workspace:*",
    "@rhema/run-sheet": "workspace:*",
    "@rhema/tokens": "workspace:*",
    "@rhema/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "1.170.40",
    "hono": "^4.6.14",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.37.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.9.1",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.21"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.168.41",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "~6.1.1",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "vite": "~8.3.1"
  }
}
